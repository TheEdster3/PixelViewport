<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PixelViewport.WinUI.Controls">

  <Style TargetType="controls:ImageViewport">
    <Setter Property="ViewportBackground" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:ImageViewport">
          <Grid
              x:Name="PART_Surface"
              Background="{TemplateBinding ViewportBackground}">
            <Grid
                x:Name="PART_ImageLayer"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
              <Grid.RenderTransform>
                <CompositeTransform x:Name="PART_Transform" />
              </Grid.RenderTransform>

              <Image
                  x:Name="PART_Image"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  IsHitTestVisible="False"
                  Stretch="Fill" />

              <ContentPresenter
                  Content="{TemplateBinding OverlayContent}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  IsHitTestVisible="False" />
            </Grid>

            <ContentPresenter
                Content="{TemplateBinding ViewportOverlayContent}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsHitTestVisible="False" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
