{
  "schemaVersion": 1,
  "product": "PixelViewport Community",
  "version": "0.2.0-alpha.2",
  "targetFramework": "net8.0",
  "verifiedPlatform": "Windows",
  "unverifiedPlatforms": [
    "Linux",
    "embedded hardware"
  ],
  "packages": [
    "PixelViewport.Core",
    "PixelViewport.Imaging",
    "PixelViewport.Avalonia",
    "PixelViewport.OpenCvSharp",
    "PixelViewport.WinUI"
  ],
  "formats": [
    "Gray8",
    "Gray16LittleEndian",
    "Rgb24",
    "Bgr24",
    "Rgba32",
    "Bgra32"
  ],
  "renderer": "UI-thread CPU conversion / Avalonia WriteableBitmap",
  "submission": "LatestFrameMailbox / bounded single pending frame / ownership transfer",
  "inspectionMember": "PixelSample.BitsPerChannel",
  "unavailable": [
    "GPU renderer",
    "WPF adapter",
    "window/level",
    "editable ROI",
    "calibrated measurements",
    "camera acquisition"
  ],
