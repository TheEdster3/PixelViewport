<Window
    x:Class="PixelViewport.Sample.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pv="using:PixelViewport.WinUI.Controls"
    mc:Ignorable="d"
    Title="PixelViewport Sample">

  <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border
        Grid.Row="0"
        Padding="12"
        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
        BorderThickness="0,0,0,1">
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0" Content="Fit" Click="Fit_Click" />
        <Button Grid.Column="1" Content="100%" Click="ActualSize_Click" />
        <Button Grid.Column="2" Content="−" Click="ZoomOut_Click" />
        <Button Grid.Column="3" Content="+" Click="ZoomIn_Click" />
        <TextBlock
            Grid.Column="5"
            x:Name="ZoomText"
            VerticalAlignment="Center"
            Text="100%" />
      </Grid>
    </Border>

    <pv:ImageViewport
        Grid.Row="1"
        x:Name="Viewer"
        AutoFit="True"
        MaxZoomFactor="32"
        MinZoomFactor="0.05"
        ViewChanged="Viewer_ViewChanged"
        ImagePointerMoved="Viewer_ImagePointerMoved">
      <pv:ImageViewport.OverlayContent>
        <Canvas Width="1600" Height="1000">
          <Border
              Canvas.Left="530"
              Canvas.Top="330"
              Width="300"
              Height="210"
              BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
              BorderThickness="3"
              CornerRadius="6" />
        </Canvas>
      </pv:ImageViewport.OverlayContent>
    </pv:ImageViewport>

    <Border
        Grid.Row="2"
        Padding="12,8"
        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
        BorderThickness="0,1,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Wheel to zoom • drag to pan • pinch on touch" Opacity="0.7" />
        <TextBlock Grid.Column="1" x:Name="PositionText" Text="x: —   y: —" />
      </Grid>
    </Border>
  </Grid>
</Window>
